{
  "extends": "@tsconfig/node26/tsconfig.json",
  "compilerOptions": {
    "rootDir": "./src",
    "outDir": "./dist",
    "strict": true,
    "lib": ["ES2022"], // 👈 Gives TypeScript access to modern JS features
    "types": ["node"] // 👈 Forces TypeScript to load Node types explicitly
  },
  "exclude": ["node_modules"],
  "include": ["src"]
}
